# Скопируй в local.properties и подставь свои значения.
#
# Ключа Anthropic здесь больше нет: он вводится в самом приложении, при первом
# запуске, и в APK не попадает вовсе.
sdk.dir=/path/to/Android/sdk

# Нужен только отправке жалоб в issues. Без него приложение работает, жалобы
# просто копятся в файле на телефоне.
GITHUB_TOKEN=github_pat_...

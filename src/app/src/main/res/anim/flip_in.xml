<?xml version="1.0" encoding="utf-8"?>
<!--
    Новая сторона раскрывается из полоски, но только после того, как старая
    сжалась (startOffset равен её длительности): обе сразу выглядели бы
    наложением, а не переворотом. До начала она уже сжата — fillBefore.
-->
<scale xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromXScale="0.0"
    android:toXScale="1.0"
    android:fromYScale="1.0"
    android:toYScale="1.0"
    android:pivotX="50%"
    android:pivotY="50%"
    android:startOffset="140"
    android:duration="140"
    android:fillBefore="true"
    android:interpolator="@android:anim/decelerate_interpolator" />

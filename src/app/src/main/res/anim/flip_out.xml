<?xml version="1.0" encoding="utf-8"?>
<!--
    Уходящая сторона карточки сжимается по ширине в полоску. Вместе с
    flip_in это читается как переворот: настоящего 3D виджеты не умеют —
    RemoteViews не принимает своих анимаций, — а сжатие к оси и раскрытие
    уже другой стороной глаз принимает за поворот.
-->
<scale xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromXScale="1.0"
    android:toXScale="0.0"
    android:fromYScale="1.0"
    android:toYScale="1.0"
    android:pivotX="50%"
    android:pivotY="50%"
    android:duration="140"
    android:interpolator="@android:anim/accelerate_interpolator" />

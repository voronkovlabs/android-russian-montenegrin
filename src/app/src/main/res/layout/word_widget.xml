<?xml version="1.0" encoding="utf-8"?>
<!--
    Словарная карточка на домашнем экране. Виджет маленький по просьбе
    владельца — две клетки на одну, — поэтому внутри ровно три надписи:
    эмодзи (если у слова он есть), черногорское слово и перевод мелким.

    Нажатие обслуживает корень целиком: цель в две клетки должна попадать
    пальцем с первого раза, а второго действия у виджета нет.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/word_widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:textSize="19sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_word"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="19sp"
            android:textColor="@color/widget_paper"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_gloss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="@color/widget_muted" />
</LinearLayout>

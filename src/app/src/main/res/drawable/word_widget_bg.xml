<?xml version="1.0" encoding="utf-8"?>
<!--
    Та же стеклянная карточка, что на главном экране приложения: скруглённый
    прямоугольник, тонкая рамка. Цвета берутся из values/colors.xml и его
    ночной пары — виджет идёт за ночным режимом системы, как и всё остальное.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="@color/widget_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Тот же такт, что у простой карточки (word_widget_info): полчаса — предел
    системы, чаще меняет нажатие. Высота больше — над текстом стоят флаг и
    кнопка «уже знаю», и при крупном шрифте в одну клетку им тесно.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="80dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/flip_widget"
    android:previewLayout="@layout/flip_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/flip_description"
    android:widgetCategory="home_screen" />

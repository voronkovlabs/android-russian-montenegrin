    { "who": "them", "sr": "Drago mi je.", "ru": "Приятно познакомиться." },
    { "who": "them", "sr": "Odakle ste?", "ru": "Откуда вы?" },
    { "who": "you", "sr": "Ja sam iz Rusije.", "ru": "Я из России." },

{
  "id": "d05",
  "title": "U servisu",
  "note": "Автосервис: машина не заводится. Урок 19.",
  "speaker": "Majstor",
  "chunks": [
    { "who": "them", "sr": "Dobar dan, šta je problem?", "ru": "Добрый день, в чём проблема?" },
    { "who": "you", "sr": "Auto ne pali ujutru.", "ru": "Машина не заводится по утрам." },
    { "who": "them", "sr": "Koliko je star akumulator?", "ru": "Сколько лет аккумулятору?" },
    { "who": "you", "sr": "Ne znam tačno, kupio sam auto polovan.", "ru": "Не знаю точно, я купил машину подержанной." },
    { "who": "them", "sr": "Provjeriću ga. Ostavite ključeve.", "ru": "Я его проверю. Оставьте ключи." },
    { "who": "you", "sr": "Koliko će trajati?", "ru": "Сколько это займёт?" },
    { "who": "them", "sr": "Sat vremena, možda dva.", "ru": "Час, может быть, два." },
    { "who": "you", "sr": "Možete li i gume da provjerite?", "ru": "Можете ещё и шины проверить?" },
    { "who": "them", "sr": "Mogu. Jedna je slaba, vidim odavde.", "ru": "Могу. Одна спущена, я отсюда вижу." },
    { "who": "you", "sr": "Koliko bi to sve koštalo?", "ru": "Сколько всё это будет стоить?" },
    { "who": "them", "sr": "Zvaću vas kad vidim šta treba.", "ru": "Я позвоню вам, когда посмотрю, что нужно." },
    { "who": "you", "sr": "U redu, evo moj broj.", "ru": "Хорошо, вот мой номер." }
  ]
}

{
  "id": "d01",
  "title": "Na pošti",
  "note": "Отправить посылку в Россию. Уроки 14 и 18.",
  "speaker": "Službenica",
  "chunks": [
    { "sr": "Dobar dan, izvolite.", "ru": "Добрый день, слушаю вас.", "who": "them" },
    { "sr": "Dobar dan.", "ru": "Добрый день.", "who": "you" },
    { "sr": "Hoću da pošaljem paket u Rusiju.", "ru": "Хочу отправить посылку в Россию.", "who": "you" },
    { "sr": "Šta je unutra?", "ru": "Что внутри?", "who": "them" },
    { "sr": "Knjige i odjeća.", "ru": "Книги и одежда.", "who": "you" },
    { "sr": "Stavite paket na vagu, molim vas.", "ru": "Поставьте посылку на весы, пожалуйста.", "who": "them" },
    { "sr": "Koliko košta?", "ru": "Сколько стоит?", "who": "you" },
    { "sr": "Dva kilograma, to je dvadeset dva evra.", "ru": "Два килограмма, это двадцать два евро.", "who": "them" },
    { "sr": "Za koliko dana stiže?", "ru": "За сколько дней дойдёт?", "who": "you" },
    { "sr": "Obično za dvije nedjelje, ponekad duže.", "ru": "Обычно за две недели, иногда дольше.", "who": "them" },
    { "sr": "Dobro, uzeću to.", "ru": "Хорошо, беру.", "who": "you" },
    { "sr": "Mogu li karticom?", "ru": "Можно картой?", "who": "you" },
    { "sr": "Naravno. Evo vam potvrda.", "ru": "Конечно. Вот вам квитанция.", "who": "them" },
    { "sr": "Hvala vam puno. Doviđenja.", "ru": "Большое спасибо. До свидания.", "who": "you" }
  ]

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Одно напоминание в день. Будильник неточный, поэтому SCHEDULE_EXACT_ALARM
         не нужен: напоминание, опоздавшее на несколько минут, остаётся напоминанием.
         RECEIVE_BOOT_COMPLETED обязателен — будильники Android перезагрузку не переживают. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Обновление из релизов GitHub: приложение показывает скачанный APK
        системному установщику, ставит его Android. Разрешение «установка из
        этого источника» человек выдаёт отдельно, на экране системы.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Crnogorski">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Crnogorski">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Приём текста извне: кнопка «Поделиться» (SEND) и пункт в меню
            выделенного текста (PROCESS_TEXT). Своя Activity, а не главная:
            поделиться можно посреди урока, и главный экран пересоздался бы
            поверх задания, а после переустановки упёрся бы в замок ключа.

            taskAffinity="" и excludeFromRecents: окно живёт своей жизнью и
            не подмешивается к приложению в списке недавних.
        -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Crnogorski.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Словарная карточка на домашнем экране (идея 143). Отдельный
            приёмник, а не Activity: виджет ничего не открывает и ничего не
            записывает, кроме номера показанного слова.

            exported="true" обязателен: обновление виджета присылает система.

            Своих действий (WIDGET_NEXT, WIDGET_REDRAW) в фильтре нет намеренно.
            Оба приходят явным намерением — с указанным классом получателя, — а
            явное намерение фильтров не спрашивает. Записанное в фильтр действие,
            наоборот, открыло бы его кому угодно снаружи.
        -->
        <receiver
            android:name=".widget.WordWidget"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/word_widget_info" />
        </receiver>

        <!--
            Карточка-перевёртыш (4.7): спереди русское, по нажатию черногорское.
            Своих действий в фильтре нет по тому же доводу, что у WordWidget.
        -->
        <receiver
            android:name=".widget.FlipWidget"
            android:label="@string/flip_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/flip_widget_info" />
        </receiver>

        <!--
            Подтверждение «уже знаю» с перевёртыша. Виджет диалогов не
            показывает, поэтому окно поверх домашнего экрана — как у
            «Поделиться». Не экспортируется: открывает его только наш виджет.
        -->
        <activity
            android:name=".ui.KnownActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Crnogorski.Share" />

        <!-- Отдаёт complaints.jsonl в share как content://; file:// с Android 7 запрещён. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
